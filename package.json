{
  "name": "gofrommunich",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/bff/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "migrate": "tsx --env-file=.env packages/db/src/migrate.ts",
    "worker": "tsx --env-file=.env apps/worker/src/cli.ts",
    "api": "tsx --env-file=.env apps/api/src/server.ts",
    "bff": "tsx --tsconfig apps/bff/tsconfig.json --env-file-if-exists=.env apps/bff/src/main.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-fastify": "^12.1.1",
    "@tanstack/react-query": "^5.104.0",
    "date-holidays": "^3.37.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "node-cron": "^4.6.0",
    "onnxruntime-node": "^1.30.0",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15"
  }
}
